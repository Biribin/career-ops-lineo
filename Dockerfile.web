# Cockpit web career-ops — service en ligne (Coolify, career.balzac-info.online).
#
# L'app Next vit dans web/ mais execute les .mjs du repo et lit ses fichiers :
# l'image contient donc TOUT le repo (code). Les RECORDS (candidatures, decisions,
# suivi) sont rediriges vers un VOLUME persistant via les env CAREER_OPS_* pour
# survivre aux redeploys (voir DEPLOY-VPS.md).
#
# Rebuild marker v2 : forcer Coolify a reconstruire avec CE Dockerfile
# (il reutilisait l'image du Dockerfile de dev, CMD bash, qui crash-loop).
# Image slim node+git : suffisant pour le cockpit (suivi, decisions, tracker).
# Le scan ATS (chromium) et le rendu LaTeX ne sont pas dans cette image v1 ;
# le CV est rendu par le repo cv (Typst) cote GitHub Actions, pas ici.

FROM node:22-bookworm-slim

# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD : les deps racine tirent playwright ; on evite
# le telechargement du navigateur (~500 Mo) inutile pour le cockpit v1.
ENV PORT=3000 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NEXT_TELEMETRY_DISABLED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*

# Claude Code CLI : l'app le lance en headless (route /api/explore/ai) pour la
# recherche IA, avec l'abonnement Max de Lineo via CLAUDE_CODE_OAUTH_TOKEN (env
# Coolify) + CAREER_OPS_CLI=claude. Sans ce binaire, resolveCli('claude') echoue.
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

# Deps racine (pour les .mjs career-ops appeles par l'app). NODE_ENV non fige
# ici : le build web a besoin des devDependencies.
COPY package.json package-lock.json* ./
RUN npm install --no-audit --no-fund

# Deps + build de l'app web
COPY web/package.json web/package-lock.json* ./web/
RUN cd web && npm install --no-audit --no-fund
COPY . .
RUN cd web && npm run build

# Relie la couche utilisateur (cv.md, profile.yml, portals.yml, _profile.md) depuis
# le VOLUME persistant a chaque demarrage : ces fichiers sont gitignores (PII), donc
# absents du clone git que Coolify construit. Sans eux, /api/tailor repond 503 et
# /api/run refuse d'evaluer. Voir docker-entrypoint-web.sh.
COPY docker-entrypoint-web.sh /usr/local/bin/career-ops-web-entrypoint
RUN chmod +x /usr/local/bin/career-ops-web-entrypoint

EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/career-ops-web-entrypoint"]
# -H :: = écoute IPv6 ET IPv4 (dual-stack). Le réseau Coolify route en IPv6 :
# sans ça, le proxy joint le conteneur en IPv6 mais Next n'écoute qu'en IPv4 -> 502.
CMD ["sh", "-c", "cd web && npx next start -p ${PORT:-3000} -H ::"]
